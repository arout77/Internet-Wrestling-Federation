{% extends "layouts/main.twig" %}

{% block title %}Booker - Choose Venue{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <div class="bg-gray-800 rounded-lg p-4 mb-6 flex justify-between items-center">
        <span class="text-gray-300">Your Current Balance:</span>
        <span class="text-2xl font-bold text-green-400">{{ balance|number_format }} Gold</span>
    </div>

    <header class="text-center my-8">
        <h1 class="text-5xl font-bold text-yellow-400">Step 1: Choose a Venue</h1>
        <p class="text-xl text-gray-300 mt-4">Select the location for your event.</p>
        <a href="{{ base_url }}/booker" class="text-blue-400 hover:text-blue-600 mt-4 inline-block">&larr; Back to Dashboard</a>
    </header>

    <form action="{{ base_url }}/booker/venue" method="post" class="max-w-4xl mx-auto">
        {{ csrf_field() }}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {% for venue in venues %}
                <label class="relative block cursor-pointer venue-card" data-venue-id="{{ venue.id }}">
                    <input type="radio" name="venue_id" value="{{ venue.id }}" class="hidden venue-radio" data-venue-id="{{ venue.id }}">
                    <div class="bg-gray-800 rounded-lg shadow-lg overflow-hidden border-2 border-transparent transition-all">
                        <img src="{{ base_url }}/public/images/venues/{{ venue.image }}" alt="{{ venue.name }}" class="w-full h-48 object-cover">
                        <div class="p-4">
                            <h3 class="text-xl font-bold text-yellow-400">{{ venue.name }}</h3>
                            <p class="text-gray-300">Capacity: {{ venue.capacity|number_format }}</p>
                            <p class="text-gray-300">Rental Cost: <span class="text-red-400">{{ venue.rental_cost|number_format }} Gold</span></p>
                        </div>
                    </div>
                </label>
            {% endfor %}
        </div>
        <div class="mb-6">
            <label for="event_name" class="block text-gray-300 mb-2">Event Name (Optional)</label>
            <input type="text" id="event_name" name="event_name" class="w-full bg-gray-700 text-white p-3 rounded" placeholder="e.g., SummerSlam, WrestleMania, etc.">
            <p class="text-gray-400 text-sm mt-1">Leave blank to auto-generate a name.</p>
        </div>
        <div class="mb-6">
            <label class="flex items-center">
                <input type="checkbox" name="is_ppv" value="1" class="mr-2">
                <span class="text-gray-300">This is a Pay Per View event</span>
            </label>
            <p class="text-gray-400 text-sm mt-1">PPV events generate additional revenue but require 10 regular events between them.</p>
        </div>

        <div class="mb-6">
            <label for="special_match_type" class="block text-gray-300 mb-2">Special Match Type (Optional)</label>
            <select name="special_match_type" id="special_match_type" class="w-full bg-gray-700 text-white p-3 rounded">
                <option value="">None</option>
                <option value="cage">Steel Cage Match</option>
                <option value="ladder">Ladder Match</option>
                <option value="submission">Submission Match</option>
                <option value="last_man_standing">Last Man Standing</option>
            </select>
            <p class="text-gray-400 text-sm mt-1">Only one special match per event.</p>
        </div>
        <div class="mt-8 text-center">
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg transition">Next: Advertising</button>
        </div>
    </form>
</div>

<script>
    document.querySelectorAll('.venue-card').forEach(card => {
        const radio = card.querySelector('.venue-radio');
        const div = card.querySelector('div');
        radio.addEventListener('change', () => {
            // Remove selected class from all
            document.querySelectorAll('.venue-card div').forEach(d => {
                d.classList.remove('border-yellow-400', 'bg-gray-700');
            });
            if (radio.checked) {
                div.classList.add('border-yellow-400', 'bg-gray-700');
            }
        });
    });
</script>
{% endblock %}