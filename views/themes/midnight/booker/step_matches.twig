{% extends "layouts/main.twig" %}

{% block title %}Booker - Book Matches{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <!-- Budget Tracker -->
    <div class="bg-gray-800 rounded-lg p-4 mb-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
            <div>
                <span class="text-gray-400 text-sm">Original Balance</span>
                <p class="text-xl font-bold text-white">{{ original_balance|number_format }} Gold</p>
            </div>
            <div>
                <span class="text-gray-400 text-sm">Total Spent</span>
                <p class="text-xl font-bold text-red-400">{{ (venue_cost + ad_spend + total_hired_fee)|number_format }} Gold</p>
            </div>
            <div>
                <span class="text-gray-400 text-sm">Remaining</span>
                <p class="text-xl font-bold text-yellow-400">{{ remaining_after_all|number_format }} Gold</p>
            </div>
        </div>
    </div>

    <header class="text-center my-8">
        <h1 class="text-5xl font-bold text-yellow-400">Step 4: Book Matches</h1>
        <p class="text-xl text-gray-300 mt-4">Create the match card (up to 10 matches). Each wrestler can be used only once.</p>
        <p class="text-md text-gray-400 mt-2">The <span class="text-red-500">★ MAIN EVENT</span> will be the last match on the card.</p>
        <a href="{{ base_url }}/booker/hire" class="text-blue-400 hover:text-blue-600 mt-4 inline-block">&larr; Back to Hire</a>
    </header>

    <form id="matches-form" action="{{ base_url }}/booker/matches" method="post" class="max-w-4xl mx-auto">
        {{ csrf_field() }}
        <div id="matches-container">
            <div class="match-entry bg-gray-800 p-4 rounded-lg mb-4" data-match-index="0">
                <h3 class="text-lg font-bold text-yellow-400 mb-2">Match 1</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <select name="matches[0][wrestler1]" class="bg-gray-700 text-white p-2 rounded wrestler-select" required>
                        <option value="">Select Wrestler 1</option>
                        {% for w in hired_wrestlers %}
                            <option value="{{ w.id }}">{{ w.name }}</option>
                        {% endfor %}
                    </select>
                    <select name="matches[0][wrestler2]" class="bg-gray-700 text-white p-2 rounded wrestler-select" required>
                        <option value="">Select Wrestler 2</option>
                        {% for w in hired_wrestlers %}
                            <option value="{{ w.id }}">{{ w.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mt-3 flex flex-wrap gap-4">
                    <div class="championship-checkbox-container" style="display: none;">
                        <label class="flex items-center">
                            <input type="checkbox" name="matches[0][is_title_match]" value="1" class="title-match-checkbox mr-2">
                            <span class="text-gray-300">Championship match</span>
                        </label>
                    </div>
                    <div>
                        <label class="text-gray-300 text-sm block mb-1">Match Stipulation</label>
                        <select name="matches[0][stipulation]" class="bg-gray-700 text-white p-2 rounded stipulation-select">
                            <option value="">None</option>
                            <option value="cage">Steel Cage Match</option>
                            <option value="ladder">Ladder Match</option>
                            <option value="i_quit">I Quit Match</option>
                            <option value="last_man_standing">Last Man Standing</option>
                            <option value="no_dq">No Disqualification Match</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="remove-match text-red-400 text-sm mt-2 hover:text-red-600">Remove match</button>
            </div>
        </div>

        <div class="flex justify-between mt-6">
            <button type="button" id="add-match" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md transition">+ Add Match</button>
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg transition">Simulate Event</button>
        </div>
    </form>
</div>

<script>
    let matchCount = 1;
    const container = document.getElementById('matches-container');
    const addBtn = document.getElementById('add-match');
    const hiredWrestlers = {{ hired_wrestlers|json_encode|raw }};
    const championIds = {{ champion_ids|json_encode|raw }};

    function updateMainEventIndicators() {
        const matches = document.querySelectorAll('.match-entry');
        matches.forEach((match, idx) => {
            const isLast = (idx === matches.length - 1);
            const titleSpan = match.querySelector('h3');
            if (isLast) {
                if (!titleSpan.querySelector('.main-event-star')) {
                    titleSpan.innerHTML = titleSpan.innerText + ' <span class="text-red-500 text-sm ml-2 main-event-star">★ MAIN EVENT</span>';
                }
            } else {
                const starSpan = titleSpan.querySelector('.main-event-star');
                if (starSpan) starSpan.remove();
            }
        });
    }

    function updateChampionshipCheckboxVisibility(matchDiv) {
        const w1Select = matchDiv.querySelector('select[name$="[wrestler1]"]');
        const w2Select = matchDiv.querySelector('select[name$="[wrestler2]"]');
        const containerDiv = matchDiv.querySelector('.championship-checkbox-container');
        if (!containerDiv) return;
        const w1Id = parseInt(w1Select.value);
        const w2Id = parseInt(w2Select.value);
        const isChampionMatch = (championIds.includes(w1Id) || championIds.includes(w2Id));
        containerDiv.style.display = isChampionMatch ? 'flex' : 'none';
        // If not a champion match, uncheck the checkbox
        if (!isChampionMatch) {
            const checkbox = containerDiv.querySelector('.title-match-checkbox');
            if (checkbox) checkbox.checked = false;
        }
    }

    function attachMatchEvents(matchDiv) {
        const selects = matchDiv.querySelectorAll('.wrestler-select');
        selects.forEach(select => {
            select.removeEventListener('change', () => updateChampionshipCheckboxVisibility(matchDiv));
            select.addEventListener('change', () => updateChampionshipCheckboxVisibility(matchDiv));
        });
        const removeBtn = matchDiv.querySelector('.remove-match');
        if (removeBtn) {
            removeBtn.addEventListener('click', () => {
                matchDiv.remove();
                renumberMatches();
            });
        }
    }

    function renumberMatches() {
        document.querySelectorAll('.match-entry').forEach((el, idx) => {
            const isLast = (idx === document.querySelectorAll('.match-entry').length - 1);
            el.querySelector('h3').innerHTML = `Match ${idx+1}${isLast ? ' <span class="text-red-500 text-sm ml-2 main-event-star">★ MAIN EVENT</span>' : ''}`;
            // Update input names to keep array indices sequential
            const selects = el.querySelectorAll('select');
            selects.forEach(select => {
                const name = select.getAttribute('name');
                if (name) {
                    const newName = name.replace(/matches\[\d+\]/, `matches[${idx}]`);
                    select.setAttribute('name', newName);
                }
            });
            const checkbox = el.querySelector('.title-match-checkbox');
            if (checkbox) {
                const cbName = checkbox.getAttribute('name');
                if (cbName) {
                    checkbox.setAttribute('name', cbName.replace(/matches\[\d+\]/, `matches[${idx}]`));
                }
            }
            // Re-attach events
            attachMatchEvents(el);
            updateChampionshipCheckboxVisibility(el);
        });
        matchCount = document.querySelectorAll('.match-entry').length;
        updateMainEventIndicators();
    }

    addBtn.addEventListener('click', () => {
        if (matchCount >= 10) {
            alert('Maximum 10 matches per event.');
            return;
        }
        const newMatch = document.createElement('div');
        newMatch.className = 'match-entry bg-gray-800 p-4 rounded-lg mb-4';
        newMatch.setAttribute('data-match-index', matchCount);
        newMatch.innerHTML = `
            <h3 class="text-lg font-bold text-yellow-400 mb-2">Match ${matchCount+1}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <select name="matches[${matchCount}][wrestler1]" class="bg-gray-700 text-white p-2 rounded wrestler-select" required>
                    <option value="">Select Wrestler 1</option>
                    ${hiredWrestlers.map(w => `<option value="${w.id}">${w.name}</option>`).join('')}
                </select>
                <select name="matches[${matchCount}][wrestler2]" class="bg-gray-700 text-white p-2 rounded wrestler-select" required>
                    <option value="">Select Wrestler 2</option>
                    ${hiredWrestlers.map(w => `<option value="${w.id}">${w.name}</option>`).join('')}
                </select>
            </div>
            <div class="mt-3 flex flex-wrap gap-4">
                <div class="championship-checkbox-container" style="display: none;">
                    <label class="flex items-center">
                        <input type="checkbox" name="matches[${matchCount}][is_title_match]" value="1" class="title-match-checkbox mr-2">
                        <span class="text-gray-300">Championship match</span>
                    </label>
                </div>
                <div>
                    <label class="text-gray-300 text-sm block mb-1">Match Stipulation</label>
                    <select name="matches[${matchCount}][stipulation]" class="bg-gray-700 text-white p-2 rounded">
                        <option value="">None</option>
                        <option value="cage">Steel Cage Match</option>
                        <option value="ladder">Ladder Match</option>
                        <option value="i_quit">I Quit Match</option>
                        <option value="last_man_standing">Last Man Standing</option>
                        <option value="no_dq">No Disqualification Match</option>
                    </select>
                </div>
            </div>
            <button type="button" class="remove-match text-red-400 text-sm mt-2 hover:text-red-600">Remove match</button>
        `;
        container.appendChild(newMatch);
        attachMatchEvents(newMatch);
        updateChampionshipCheckboxVisibility(newMatch);
        matchCount++;
        updateMainEventIndicators();
    });

    // Attach events to initial matches
    document.querySelectorAll('.match-entry').forEach(match => {
        attachMatchEvents(match);
        updateChampionshipCheckboxVisibility(match);
    });

    // Initial main event indicator
    updateMainEventIndicators();
</script>
{% endblock %}