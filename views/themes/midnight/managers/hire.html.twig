{% extends "layouts/main.twig" %}

{% block title %}Hire a Manager{% endblock %}

{% block content %}
<div class="container mx-auto p-4">
    <header class="text-center my-8">
        <h1 class="text-5xl font-bold text-yellow-400">Hire a Manager</h1>
        <p class="text-xl text-gray-300">Invest in a legend to guide your career to new heights.</p>
        <a href="{{ base_url }}/career" class="text-blue-400 hover:text-blue-600 mt-4 inline-block">&larr; Back to Career</a>
    </header>

    {% if currentManager %}
        <div class="bg-gray-800 rounded-lg shadow-lg p-6 mb-8 flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <img src="{{ base_url }}/public/media/images/managers/{{ currentManager.image }}.webp" alt="{{ currentManager.name }}" class="w-16 h-16 rounded-full object-cover">
                <div>
                    <h2 class="text-2xl font-bold text-yellow-400">Current Manager: {{ currentManager.name }}</h2>
                    <p class="text-gray-300">This manager is currently guiding your career.</p>
                </div>
            </div>
            <button id="fire-manager-btn" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-md transition">
                Fire Manager
            </button>
        </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
        {% for manager in managers %}
            <div class="bg-gray-900 rounded-lg shadow-lg overflow-hidden flex flex-col h-full">
                <!-- Image container with relative positioning for the banner -->
                <div class="relative">
                    <img src="{{ base_url }}/public/media/images/managers/{{ manager.image }}.webp" alt="{{ manager.name }}" class="w-full h-64 object-cover object-top">
                    <!-- Diagonal cost banner -->
                    <div class="absolute top-6 left-0 bg-black bg-opacity-75 text-yellow-400 font-bold text-sm px-3 py-0.5  origin-top-left shadow-md z-10">
                        {{ manager.cost|number_format }} Gold
                    </div>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <h2 class="text-2xl font-bold text-yellow-400 mb-2">{{ manager.name }}</h2>
                    <div class="text-gray-400 text-sm mb-4 overflow-y-auto max-h-32 pr-2">
                        {{ manager.description }}
                    </div>
                    
                    <div class="bg-gray-700 p-4 rounded-md mb-4">
                        <h3 class="text-lg font-semibold text-white mb-3">Bonuses & Requirements</h3>
                        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                            <p>XP Boost: <span class="font-bold text-green-400">+{{ manager.xpBonus * 100 }}%</span></p>
                            <p>Gold Boost: <span class="font-bold text-green-400">+{{ manager.goldBonus * 100 }}%</span></p>
                            <p>Strength: <span class="font-bold text-blue-400">+{{ manager.strengthBonus }}</span></p>
                            <p>Brawling: <span class="font-bold text-blue-400">+{{ manager.brawlingAbilityBonus }}</span></p>
                            <p>Technical: <span class="font-bold text-blue-400">+{{ manager.technicalAbilityBonus }}</span></p>
                            <p>Aerial: <span class="font-bold text-blue-400">+{{ manager.aerialAbilityBonus }}</span></p>
                            <p>Stamina: <span class="font-bold text-blue-400">+{{ manager.staminaBonus }}</span></p>
                            <p>Toughness: <span class="font-bold text-blue-400">+{{ manager.toughnessBonus }}</span></p>
                            <p class="col-span-2">Level Req: <span class="font-bold text-gray-300">{{ manager.levelRequirement }}</span></p>
                        </div>
                    </div>

                    {% if prospect.lvl >= manager.levelRequirement %}
                        {% if currentManager and currentManager.id == manager.id %}
                            <button class="w-full bg-gray-600 text-gray-400 font-bold py-3 px-4 rounded-md mt-auto" disabled>
                                Already Hired
                            </button>
                        {% else %}
                            <button 
                                class="hire-btn w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-md transition duration-300 mt-auto" 
                                data-manager-id="{{ manager.id }}"
                                data-cost="{{ manager.cost }}">
                                Hire for {{ manager.cost }} Gold
                            </button>
                        {% endif %}
                    {% else %}
                        <button class="w-full bg-gray-600 text-gray-400 font-bold py-3 px-4 rounded-md mt-auto" disabled>
                            Requires Level {{ manager.levelRequirement }}
                        </button>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<script>
    document.querySelectorAll('.hire-btn').forEach(button => {
        button.addEventListener('click', async (e) => {
            const managerId = e.target.dataset.managerId;
            const cost = parseInt(e.target.dataset.cost, 10);

            if (!confirm(`Are you sure you want to hire this manager for ${cost} Gold?`)) {
                return;
            }

            try {
                const response = await fetch(`{{ base_url }}/manager/purchase/${managerId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    showNotification(result.message, 'success');
                    updateGoldDisplay(result.newGold);
                    window.location.reload();
                } else {
                    showNotification('Error: ' + (result.error || 'Could not hire manager.'), 'error');
                }
            } catch (error) {
                console.error('Failed to hire manager:', error);
                showNotification('An error occurred. Please try again.', 'error');
            }
        });
    });

    const fireBtn = document.getElementById('fire-manager-btn');
    if (fireBtn) {
        fireBtn.addEventListener('click', async () => {
            if (!confirm('Are you sure you want to fire your current manager? All bonuses will be removed.')) {
                return;
            }

            try {
                const response = await fetch('{{ base_url }}/manager/fire', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    showNotification(result.message, 'success');
                    window.location.reload();
                } else {
                    showNotification('Error: ' + (result.error || 'Could not fire manager.'), 'error');
                }
            } catch (error) {
                console.error('Failed to fire manager:', error);
                showNotification('An error occurred. Please try again.', 'error');
            }
        });
    }
</script>
{% endblock %}