{% extends "layouts/main.twig" %}

{% block content %}
    <h2 class="text-3xl font-bold text-center text-gray-800 dark:text-gray-200 mb-6">Create free account</h2>

    <form action="{{ base_url }}/register" method="POST" class="max-w-xl space-y-4 mx-auto glass p-8">
        {{ csrf_field() }}
        <div>
            <label for="name" class="block text-gray-700 dark:text-gray-300 font-bold mb-2">Name</label>
            <input type="text" name="name" value="{{ old.name|e }}" class="input  py-2 px-4 rounded-sm border-4 border-purple-600 {{ errors.name ? 'input-error' : '' }}">
            {% if errors.name %}<div class="error-message">{{ errors.name|first }}</div>{% endif %}
        </div>
        <div>
            <label for="email" class="block text-gray-700 dark:text-gray-300 font-bold mb-2">Email</label>
            <input type="email" name="email" value="{{ old.email|e }}" class="input  py-2 px-4 rounded-sm border-4 border-purple-600 {{ errors.email ? 'input-error' : '' }}">
            {% if errors.email %}<div class="error-message">{{ errors.email|first }}</div>{% endif %}
        </div>
        <div>
            <label for="password" class="block text-gray-700 dark:text-gray-300 font-bold mb-2">Password</label>
            <input type="password" name="password" class="input  py-2 px-4 rounded-sm border-4 border-purple-600 {{ errors.password ? 'input-error' : '' }}">
            {% if errors.password %}<div class="error-message">{{ errors.password|first }}</div>{% endif %}
        </div>
        <div>
            <label for="password_confirmation" class="block text-gray-700 dark:text-gray-300 font-bold mb-2">Confirm Password</label>
            <input type="password" name="password_confirmation" class="input  py-2 px-4 rounded-sm border-4 border-purple-600">
        </div>
        <div>
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Register</button>
        </div>
    </form>
    
    <style>.input{width:100%;line-height:1.5rem}.input-error{border-color:#EF4444}.error-message{color:#EF4444;font-size:.875rem;margin-top:.25rem}</style>
{% endblock %}
