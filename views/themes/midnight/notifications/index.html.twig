{% extends "layouts/main.twig" %}

{% block title %}Notifications{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <h1 class="text-4xl font-bold text-yellow-400 mb-8">Notifications</h1>

    {% if notifications is empty %}
        <div class="bg-gray-800 rounded-lg p-8 text-center">
            <p class="text-gray-400 text-lg">You have no notifications.</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for notification in notifications %}
                <div class="bg-gray-800 rounded-lg p-4 shadow-md border border-gray-700 {% if not notification.isIsRead %}border-l-4 border-l-yellow-500{% endif %}">
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <p class="text-white">{{ notification.message }}</p>
                            <p class="text-gray-400 text-sm mt-1">{{ notification.getTimeAgo() }}</p>
                        </div>
                        {% if notification.link %}
                            <a href="{{ base_url }}{{ notification.link }}" class="ml-4 bg-blue-600 hover:bg-blue-700 text-white text-sm px-3 py-1 rounded">View</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}